PORT=4311
HOST=127.0.0.1
DATA_DIR=./data

# Configure all three together to enable verified-email accounts.
# Never prefix these values with VITE_ or put the secret key in browser code.
# In Supabase, apply emails\auth-code.html to BOTH Confirm signup and Magic Link.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-or-service-role-key

# Local review accepts localhost and 127.0.0.1 on port 5173.
APP_ORIGIN=http://localhost:5173
# npm start requires all Supabase settings and an HTTPS APP_ORIGIN.
# For deployment: APP_ORIGIN=https://your-roomlings-domain.example

# SQLite remains the default until migration and cutover are explicitly selected.
DATABASE_DRIVER=sqlite
DATABASE_SCHEMA=roomlings
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Download the database CA certificate from Supabase Database Settings.
# DATABASE_SSL_ROOT_CERT=supabase-ca.crt
# DATABASE_TLS=verify-full

# Native push is optional. Without complete configuration preferences still work,
# pushAvailable is false, and registration returns 503 PUSH_NOT_CONFIGURED.
# Use server-only secrets. Never enable HTTP/2 header/debug logging in deployment.
# APNS_TEAM_ID=YOURTEAMID
# APNS_TOPIC=com.roomlings.app
# Configure at least one environment with the matching Apple .p8 key.
# Restrict the key files to the server account (0600); data/ is ignored by Git.
# APNS_SANDBOX_KEY_ID=YOURKEY123
# APNS_SANDBOX_KEY_PATH=./data/apns-sandbox.p8
# APNS_PRODUCTION_KEY_ID=YOURKEY456
# APNS_PRODUCTION_KEY_PATH=./data/apns-production.p8
# A separate base64-encoded 32-byte random secret, shared by API and workers.
# PUSH_TOKEN_ENCRYPTION_KEY=replace-with-your-protected-secret
# inline starts the worker with the API. external requires npm run push:worker.
# disabled stops registration/delivery while retaining preference access.
PUSH_WORKER_MODE=inline
